# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard > Project Settings > API Keys

# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared secret the SMS gateway sends in the x-webhook-secret header. Server-only.
# Generate a long random value and store its bcrypt hash in the database (README, step "SMS webhook").
# No Supabase secret/service key is needed: the database function checks this secret itself.
SMS_WEBHOOK_SECRET=

# Shows the "SAMPLE DATA" notice on public trace pages. Set to false once real data is used.
NEXT_PUBLIC_SAMPLE_DATA=true
